# TYCHERRA — environment variables
# Copy to .env.local for development; set these in Vercel for deploy.

# ─────────────────────────────────────────────────────────────────────
# Serverless email (Resend) — SERVER-SIDE ONLY. Never NEXT_PUBLIC_*.
# ─────────────────────────────────────────────────────────────────────

# Resend API key. REQUIRED in production. If unset OUTSIDE production the
# route runs a safe DRY-RUN (validate + log, no email sent) so local and
# preview stay testable with no credentials. In production with no key the
# route returns 500 rather than pretending it sent.
RESEND_API_KEY=

# Where enquiries are delivered.
CONTACT_TO=tycherra@gmail.com

# The verified sender. onboarding@resend.dev needs no DNS but only
# delivers to the address that owns the Resend account — correct for
# staging. Swap this ONE value once a domain is verified, e.g.
#   Tycherra <studio@tycherra.com>
RESEND_FROM=Tycherra <onboarding@resend.dev>

# ─────────────────────────────────────────────────────────────────────
# Site
# ─────────────────────────────────────────────────────────────────────

# Absolute origin for canonical URLs, sitemap, robots and OG images.
# Set to the Vercel preview/production URL until a domain is live.
NEXT_PUBLIC_SITE_URL=
